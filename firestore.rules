rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared Data
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Student Data
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Teacher Data
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Chats Data
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Groups Data
    match /groups/{groupId} {
      allow read, write: if true;
      
      match /group_messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Quizzes Data
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true; 
    }

    // Lectures Data
    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if true; 
    }

    // Quiz Submissions Data
    match /quiz_submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
